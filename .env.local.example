# Supabase (trouve ces valeurs dans Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx
# Utilisée par les scripts locaux et la suppression automatique côté serveur. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Secret de la tâche Vercel Cron. À configurer uniquement dans Vercel Production.
CRON_SECRET=

# Anthropic (pour la génération de liste IA)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Fournisseur IA : 'mistral' (dev, gratuit) ou 'anthropic' (prod)
AI_PROVIDER=mistral
# Mistral (console.mistral.ai > API Keys)
MISTRAL_API_KEY=xxxxxxxx
