# Supabase (trouve ces valeurs dans Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx
# Uniquement pour scripts/claim-existing-events.mjs. Ne jamais ajouter dans Vercel ni préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (pour la génération de liste IA)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Fournisseur IA : 'mistral' (dev, gratuit) ou 'anthropic' (prod)
AI_PROVIDER=mistral
# Mistral (console.mistral.ai > API Keys)
MISTRAL_API_KEY=xxxxxxxx
